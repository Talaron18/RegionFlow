+# 9. first_term='frozen' ------------------------------------------------------------
+for est, tan in (("fd", "frozen"), ("fd", "cond"), ("jvp", "boundary")):
+    cfg = RefMeanFlowConfig(estimator=est, fd_eps=0.025, tangent=tan,
+                            first_term="frozen", norm_p=0.0)
