# Copy to docker/.env (NOT the repo root -- see SETUP.md step 4: Compose v2
# takes the project directory from the compose file's own location, so a
# root-level .env is silently ignored when you run
# `docker compose -f docker/compose.yml ...`, and DATA_DIR falls back to the
# literal default in compose.yml).
#
#   cp docker/.env.example docker/.env

# SD3-Medium is a gated repo: accept the licence on Hugging Face first,
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host path for weights, datasets and outputs. Point this at the 3 TB disk.
# Expect ~25 GB for SD3 + T5 + CLIP, ~2.5 GB for SAM ViT-H, a few GB per bench.
DATA_DIR=/mnt/data/regionflow

# Match container user to host user so bind-mounted files stay writable.
# `export UID=$(id -u) GID=$(id -g)` in the shell works too (SETUP.md's own
# documented flow does it that way); these are a fallback if you forget.
UID=1000
GID=1000
