+def masks_for_case(case, rec):
+    """(target_mask, sibling_masks) in 512x512 bench frame, or (None, []).
+
+    Extracted so the blind multi-arm deck and the single-arm sheet cannot
+    drift apart. A second copy of this would be the mask-side version of the
+    duplicated outcome classifier that produced the 47-vs-43 disagreement.
+    """
+    H, W = case["coco_hw"]
+    anns = {a["id"]: a for a in rec["anns"]}
+
+    def m(i):
+        a = anns.get(int(i))
+        return None if a is None else apply_rect(
+            raster(a["segmentation"], W, H), case["rect"], (512, 512))
+
+    tmask = m(case["target_id"])
+    if tmask is None or not tmask.any():
+        return None, []
+    smasks = [x for x in (m(i["id"]) for i in case["instances"]
+                          if i["category"] == case["category"]
+                          and i["id"] != case["target_id"]) if x is not None]
+    return tmask, smasks
+
+
